# GitHub token for the collector (`ossdex update`). A classic personal access token with no scopes is
# enough for public repos. If this is empty, `gh auth token` is tried.
GITHUB_TOKEN=
# OSSDEX_GITHUB_TOKEN=   # use a separate token for ossdex, if you do not want to share your usual one

# Collect repos with at least this many stars (override per run with `--min-stars`)
OSSDEX_MIN_STARS=1000
# Topics left out of the collection (comma separated; empty to keep everything)
OSSDEX_EXCLUDE_TOPICS=awesome-list,awesome,books,tutorial,interview
# false keeps repos without a license too (they are all rights reserved, not open source)
OSSDEX_REQUIRE_LICENSE=true

# Where the database and indexes live (defaults to ./data)
# OSSDEX_DATA=data
# OSSDEX_DB=data/ossdex.db
