# /etc/ossdex/server.env  (chmod 640, owner root:ossdex)
OSSDEX_HOME=/srv/ossdex
# The public hostname; also turns the rate limits on.
OSSDEX_PUBLIC_HOST=ossdex.example.com
# Worker processes = CPU cores (run `nproc`).
OSSDEX_WORKERS=2
# Optional tuning (defaults shown):
# OSSDEX_MAX_QUERIES=1          # queries running at once inside one worker
# OSSDEX_QUERY_TIMEOUT=5        # seconds, including time spent queued
# OSSDEX_RATE_WEB=120           # requests per minute per client for /api, all workers together
# OSSDEX_RATE_MCP=600           # requests per minute per client for /mcp (Claude's servers share a few IPs)
# OSSDEX_TRUSTED_PROXIES=       # extra proxy addresses besides 127.0.0.1
